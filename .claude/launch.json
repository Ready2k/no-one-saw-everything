{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend_server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["manage.py", "runserver"],
      "cwd": "environment/frontend_server",
      "port": 8000
    },
    {
      "name": "mystery-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "MYSTERY_LLM_PROVIDER=auto MYSTERY_LLM_DIALOGUE_ENABLED=true .venv/bin/uvicorn app.main:app --port 8010"
      ],
      "cwd": "mystery/backend",
      "port": 8010
    },
    {
      "name": "mystery-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "mystery/frontend",
      "port": 5173
    },
    {
      "name": "mystery-backend-alt",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", ".venv/bin/uvicorn app.main:app --port 8011"],
      "cwd": "mystery/backend",
      "port": 8011
    },
    {
      "name": "mystery-frontend-alt",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "MYSTERY_API_PORT=8011 npm run dev -- --port 5174 --strictPort"
      ],
      "cwd": "mystery/frontend",
      "port": 5174
    }
  ]
}
