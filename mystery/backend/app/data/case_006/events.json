  {
    "event_id": "ev_1800_ruth_confronts",
    "time": "18:00",
    "location_id": "loc_marcus_house",
    "agent_ids": [
      "agent_ruth",
      "agent_marcus"
    ],
    "event_type": "conversation",
    "truth_description": "Ruth comes to Marcus's door at six with an envelope she has carried for thirty years: her own birth certificate, Henry Bell named as her father. He answers in his dressing gown — 'Evening, Mrs Calder' — and takes it for the post. She makes him read it, and tells him plainly what it means: that they are brother and sister. He is not cruel about it. He is barely interested. He says the will goes to Thomas, that she may contest it and lose, and that it is late. Then he thanks her, by her married name, and shuts the door.",
    "visibility": "hidden",
    "object_ids": [
      "obj_birth_certificate"
    ],
    "importance": 9,
    "linked_clue_ids": [
      "clue_ruth_visit_evening"
    ]
